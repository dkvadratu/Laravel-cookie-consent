{
    "name": "dkvadratu/laravel-cookie-consent",
    "description": "Cookie consent registration and audit log for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "whitecube/laravel-cookie-consent": "^1.3.9"
    },
    "suggest": {
        "filament/filament": "^5.0 for the optional consent log panel"
    },
    "autoload": {
        "psr-4": {
            "Dkvadratu\\CookieConsent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dkvadratu\\CookieConsent\\CookieConsentServiceProvider"
            ]
        }
    }
}
